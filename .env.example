# Browser-visible Supabase configuration.
# Copy to .env.local and fill in values from the Supabase project's API settings.
# Never commit real values. The publishable/anon key is safe for the browser;
# the service-role key must NEVER be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
