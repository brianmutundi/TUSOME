{
  "name": "tusome-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "TUSOME analytics dashboard and student report cards (Next.js + Supabase RPC).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:check-rpcs": "node scripts/check-rpcs.mjs",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File local/start.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File local/stop.ps1",
    "local:reset": "node local/reset.mjs",
    "local:doctor": "node local/doctor.mjs",
    "local:verify": "node local/verify.mjs",
    "local:test": "powershell -NoProfile -ExecutionPolicy Bypass -File local/test.ps1",
    "db:check-definers": "node scripts/check-definers.mjs",
    "db:check-rls": "node scripts/check-rls.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.66.0",
    "next": "14.2.35",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
